rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "admin"
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    function isOwnAdminCreate(uid) {
      return isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.role == "admin"
        && request.resource.data.active == true;
    }

    match /admins/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isOwnAdminCreate(uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /programs/{programId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /projects/{projectId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /articles/{articleId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /stats/{statId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /sponsorship_photos/{photoId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /pages/{pageId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /site_settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /media/{mediaId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /gallery_items/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /gallery_blobs/{blobId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /ai_generated_content/{contentId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
